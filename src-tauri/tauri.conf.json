{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Identity Manager",
  "version": "0.1.0",
  "identifier": "dev.gitidentity.manager",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Identity Manager",
        "width": 1200,
        "height": 640,
        "minWidth": 1180,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "phricardo.com",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
